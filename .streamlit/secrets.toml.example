# Copy to .streamlit/secrets.toml locally, or paste into the app's Secrets on
# Streamlit Community Cloud. Never commit the real file.

ANTHROPIC_API_KEY = ""              # optional: without it the app uses written explanations
DATABASE_URL = ""                   # Supabase: postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres
USER_ID_SALT = ""                   # any long random string; keep it forever (changing it orphans saved progress)

[auth]
redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"   # locally: http://localhost:8501/oauth2callback
cookie_secret = ""                  # another long random string

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
